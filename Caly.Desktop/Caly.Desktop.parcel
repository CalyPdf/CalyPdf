{
    "GeneralSettings": {
        "NetProjectPath": "Caly.Desktop.csproj",
        "PackageName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        },
        "AssemblyName": {
            "$type": "msbuild",
            "property": "AssemblyName"
        },
        "ApplicationName": "Caly Pdf Reader",
        "Version": {
            "$type": "msbuild",
            "property": "Version"
        },
        "FileTypes": [
            {
                "Name": "pdf",
                "Extension": "pdf",
                "MimeType": "application/pdf",
                "NormalizedExtension": "pdf"
            }
        ]
    },
    "LinuxSettings": {
        "AppIcon": "../Logo/Favicon Transparent_2.png",
        "CopyrightFile": "../LICENSE",
        "DesktopCategory": "Viewer",
        "CreateBinSymlink": "True"
    },
    "Win32Settings": {
        "InstallerIcon": "../Logo/Favicon Transparent_2.ico",
        "InstallerLicense": "../LICENSE",
        "InstallerRequiresAdmin": "False",
        "IncludeUninstaller": "True"
    },
    "MacOsSettings": {
        "CreateBundle": true,
        "BundleIdentifier": "com.CompanyName.Caly",
        "SigningCredentialsType": "AdHoc"
    },
    "PublishSettings": {
        "PublishSingleFile": "True",
        "PublishTrimmed": "True",
        "PublishReadyToRun": "True",
        "ExtraBuildProperties": {}
    }
}