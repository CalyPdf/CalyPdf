<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Caly.Core.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:vm="clr-namespace:Caly.Core.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:DataType="vm:MainViewModel"
        x:Class="Caly.Core.Views.MainWindow"
        Icon="/Assets/caly-logo.ico"
        Title="{Binding AppName}"
        MinWidth="250"
        Width="250"
        Height="150"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen">
    <Border DragDrop.AllowDrop="True"
            Margin="{Binding $parent[Window].OffScreenMargin}">
        <views:MainView WindowDecorationProperties.ElementRole="User" />
    </Border>
</Window>
