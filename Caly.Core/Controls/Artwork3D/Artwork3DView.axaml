<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Caly.Core.ViewModels"
             xmlns:artwork3d="clr-namespace:Caly.Core.Controls.Artwork3D"
             xmlns:scene3d="clr-namespace:Caly.Scene3D.Avalonia;assembly=Caly.Scene3D.Avalonia"
             x:Class="Caly.Core.Controls.Artwork3D.Artwork3DView"
             x:DataType="vm:Artwork3DViewModel"
             x:CompileBindings="True"
             StatusCommand="{Binding ControlStatusChangedCommand}"
             CameraState="{Binding CameraState, Mode=TwoWay}">

	<UserControl.Styles>
		<!-- The toolbar's icon buttons. -->
		<Style Selector="Button.tool">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.tool PathIcon">
			<Setter Property="Width" Value="14"/>
			<Setter Property="Height" Value="14"/>
		</Style>

		<!-- The lighting panel's rows: a name, a slider, its value. -->
		<Style Selector="Grid.shading TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="Grid.shading Slider">
			<Setter Property="Width" Value="150"/>
			<Setter Property="Margin" Value="10,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<!-- A piece of 3D artwork being viewed in place. Built by PageItem only while its page has one. -->
	<artwork3d:Artwork3DPlacementPanel ArtworkBounds="{Binding Bounds}"
	                                   VisibleArea="{Binding $parent[artwork3d:Artwork3DView].VisibleArea}"
	                                   ZoomLevel="{Binding $parent[artwork3d:Artwork3DView].ZoomLevel}">

		<!-- Until there is a model to draw, the page (the artwork's poster) shows through. -->
		<scene3d:Scene3DControl Name="View3D"
		                        Scene="{Binding Scene}"
		                        View="{Binding SelectedView}"
		                        Shading="{Binding Shading}"
		                        PrepareEdges="{Binding HasEdgeViews}"
		                        RenderModeOverride="{Binding RenderMode}"
		                        DefaultBackground="{Binding Scene, Converter={x:Static artwork3d:Artwork3DView.BackgroundForScene}}"
		                        PanModifiers="Shift"
		                        ResetKey="{x:Null}"
		                        HighlightColor="{x:Static artwork3d:Artwork3DView.SelectionHighlightColor}"/>

		<!-- Where the "3D" badge was. -->
		<Border Name="Toolbar"
		        Margin="4"
		        Padding="3"
		        CornerRadius="4"
		        BorderThickness="1"
		        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
		        Background="{DynamicResource SystemRegionBrush}">
			<StackPanel Orientation="Horizontal"
			            Spacing="3">

				<TextBlock Text="Loading 3D…"
				           FontSize="12"
				           Margin="6,2"
				           VerticalAlignment="Center"
				           IsVisible="{Binding IsLoading}"/>

				<ComboBox Name="ViewList"
				          ItemsSource="{Binding ViewNames}"
				          SelectedIndex="{Binding SelectedViewIndex}"
				          IsVisible="{Binding !IsLoading}"
				          DropDownClosed="OnViewListDropDownClosed"
				          MinWidth="120"
				          MaxWidth="260"
				          MinHeight="26"
				          Padding="8,2,0,2"
				          FontSize="12"
				          VerticalAlignment="Center"
				          ToolTip.Tip="3D view"
				          AutomationProperties.Name="3D view"/>

				<!-- The render mode: the view's, as the document asks, until the reader chooses another. -->
				<ComboBox Name="RenderModeList"
				          ItemsSource="{x:Static vm:Artwork3DViewModel.RenderModeNames}"
				          SelectedIndex="{Binding RenderModeIndex}"
				          IsVisible="{Binding !IsLoading}"
				          DropDownClosed="OnViewListDropDownClosed"
				          MinWidth="110"
				          MaxDropDownHeight="420"
				          MinHeight="26"
				          Padding="8,2,0,2"
				          FontSize="12"
				          VerticalAlignment="Center"
				          ToolTip.Tip="Render mode"
				          AutomationProperties.Name="Render mode"/>

				<!-- Only for a model that moves. -->
				<Button Classes="tool"
				        Click="OnPlayPauseClick"
				        ToolTip.Tip="Play or pause the animation"
				        AutomationProperties.Name="Play or pause the animation">
					<Button.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.And}">
							<Binding Path="!IsLoading"/>
							<Binding Path="#View3D.HasAnimation"/>
						</MultiBinding>
					</Button.IsVisible>
					<Panel Width="14" Height="14">
						<PathIcon Data="{StaticResource play_regular}"
								  IsVisible="{Binding !#View3D.IsAnimationPlaying}"/>
						<PathIcon Data="{StaticResource pause_regular}"
								  IsVisible="{Binding #View3D.IsAnimationPlaying}"/>
					</Panel>
				</Button>

				<Button Classes="tool"
				        Click="OnRestartAnimationClick"
				        ToolTip.Tip="Play the animation from the start"
				        AutomationProperties.Name="Play the animation from the start">
					<Button.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.And}">
							<Binding Path="!IsLoading"/>
							<Binding Path="#View3D.HasAnimation"/>
						</MultiBinding>
					</Button.IsVisible>
					<PathIcon Data="{StaticResource previous_regular}"/>
				</Button>

				<Button Classes="tool"
				        Click="OnResetClick"
				        IsVisible="{Binding !IsLoading}"
				        ToolTip.Tip="Reset view"
				        AutomationProperties.Name="Reset view">
					<PathIcon Data="{StaticResource arrow_clockwise_regular}"/>
				</Button>

				<!-- Lights and materials, changed by the reader; the file's values each time an artwork is opened. -->
				<Button Classes="tool"
				        IsVisible="{Binding !IsLoading}"
				        ToolTip.Tip="Lighting"
				        AutomationProperties.Name="Lighting">
					<PathIcon Data="{StaticResource weather_sunny_regular}"/>
					<Button.Flyout>
						<!-- Above the toolbar, off the model, so that the model can be watched while a slider moves. -->
						<Flyout Placement="TopEdgeAlignedLeft">
							<StackPanel Spacing="6">
								<StackPanel.Resources>
									<!-- Compact rows: Fluent leaves 15 px above and below the thumb (room for tick bars); a fixed slider height clipped it. -->
									<GridLength x:Key="SliderPreContentMargin">6</GridLength>
									<GridLength x:Key="SliderPostContentMargin">6</GridLength>
								</StackPanel.Resources>

								<Grid Classes="shading"
								      ColumnDefinitions="Auto,Auto,48"
								      RowDefinitions="Auto,Auto,Auto,Auto,Auto">

									<TextBlock Grid.Row="0" Text="Brightness"/>
									<Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" LargeChange="0.25"
									        Value="{Binding LightIntensity}" AutomationProperties.Name="Brightness"/>
									<TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LightIntensity, StringFormat={}{0:P0}}"/>

									<TextBlock Grid.Row="1" Text="Ambient"/>
									<Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.02" LargeChange="0.1"
									        Value="{Binding AddedAmbient}" AutomationProperties.Name="Ambient"/>
									<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AddedAmbient, StringFormat=+{0:P0}}"/>

									<TextBlock Grid.Row="2" Text="Shine"/>
									<Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="3" SmallChange="0.05" LargeChange="0.25"
									        Value="{Binding SpecularIntensity}" AutomationProperties.Name="Shine"/>
									<TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SpecularIntensity, StringFormat={}{0:P0}}"/>

									<TextBlock Grid.Row="3" Text="Highlight size"/>
									<Slider Grid.Row="3" Grid.Column="1" Minimum="-2" Maximum="2" SmallChange="0.1" LargeChange="0.5"
									        Value="{Binding HighlightSizeSteps}" AutomationProperties.Name="Highlight size"
									        ToolTip.Tip="Left: tight highlights. Right: broad ones."/>
									<TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding HighlightSize, StringFormat=×{0:0.##}}"/>

									<TextBlock Grid.Row="4" Text="Colour"/>
									<Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1.5" SmallChange="0.05" LargeChange="0.25"
									        Value="{Binding DiffuseIntensity}" AutomationProperties.Name="Colour"/>
									<TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding DiffuseIntensity, StringFormat={}{0:P0}}"/>
								</Grid>

								<Button Content="Reset"
								        Command="{Binding ResetShadingCommand}"
								        HorizontalAlignment="Right"
								        FontSize="12"
								        ToolTip.Tip="Lights and materials as the file has them"/>
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>

				<Button Classes="tool"
				        Command="{Binding CloseCommand}"
				        ToolTip.Tip="Close 3D view"
				        AutomationProperties.Name="Close 3D view">
					<PathIcon Data="{StaticResource dismiss_regular}"/>
				</Button>

			</StackPanel>
		</Border>

		<!-- Axes of the world as the camera sees them, at the top right of what is on screen. -->
		<scene3d:AxisGizmoControl HorizontalAlignment="Right"
		                          VerticalAlignment="Top"
		                          Margin="4"
		                          CameraOrientation="{Binding #View3D.CameraOrientation}">
			<scene3d:AxisGizmoControl.IsVisible>
				<MultiBinding Converter="{x:Static BoolConverters.And}">
					<Binding Path="!IsLoading"/>
					<Binding Path="Scene" Converter="{x:Static ObjectConverters.IsNotNull}"/>
				</MultiBinding>
			</scene3d:AxisGizmoControl.IsVisible>
		</scene3d:AxisGizmoControl>

	</artwork3d:Artwork3DPlacementPanel>
</UserControl>
