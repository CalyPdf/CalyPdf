<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Caly.Core.Controls"
                    xmlns:converters="using:Caly.Core.Converters"
                    xmlns:vm="clr-namespace:Caly.Core.ViewModels"
                    xmlns:progRing="clr-namespace:AvaloniaProgressRing;assembly=AvaloniaProgressRing"
                    xmlns:utilities="clr-namespace:Caly.Core.Utilities"
                    xmlns:rendering="clr-namespace:Caly.Core.Controls.Rendering">

    <converters:ProgressRingSizeConverter x:Key="ProgressRingSizeConverter"/>
    <converters:ProgressRingMarginConverter x:Key="ProgressRingMarginConverter"/>

    <Design.PreviewWith>
		<StackPanel Width="400" Height="400">
			<controls:PageItem x:DataType="vm:PageViewModel"
                               Picture="{Binding PdfPicture}"
                               IsPageRendering="{Binding IsPageRendering}"/>
		</StackPanel>
	</Design.PreviewWith>

	<ControlTheme x:Key="{x:Type controls:PageItem}"
                  TargetType="controls:PageItem"
                  x:DataType="vm:PageViewModel">

        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Exception" Value="{Binding Exception}"/>
		<Setter Property="Width" Value="{Binding DisplayWidth}"/>
		<Setter Property="Height" Value="{Binding DisplayHeight}"/>
        <Setter Property="IsRotating" Value="{Binding IsRotating}"/>
        <Setter Property="Rotation" Value="{Binding Rotation}"/>
		<Setter Property="Picture" Value="{Binding PdfPicture}"/>
		<Setter Property="VisibleArea" Value="{Binding VisibleArea}"/>
		<Setter Property="IsPageRendering" Value="{Binding IsPageRendering}"/>
		<Setter Property="IsPageVisible" Value="{Binding IsPageVisible}"/>

		<!-- ContextFlyout -->
		<Setter Property="ContextFlyout">
			<MenuFlyout>
				<MenuItem Header="{DynamicResource StringTextFlyoutCopyText}"
                          Command="{Binding CopyTextCommand}"
                          InputGesture="{x:Static utilities:CalyHotkeyConfiguration.CopyGesture}"/>

				<Separator/>

				<MenuItem Header="Rotate Clockwise"
                          Command="{Binding RotateClockwiseCommand}"
                          CommandParameter="{Binding PageNumber}">
					<MenuItem.Icon>
						<PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource arrow_rotate_clockwise_regular}"/>
					</MenuItem.Icon>
				</MenuItem>

				<MenuItem Header="Rotate Counterclockwise"
                          Command="{Binding RotateCounterclockwiseCommand}"
                          CommandParameter="{Binding PageNumber}">
					<MenuItem.Icon>
						<PathIcon Width="15"
                                  Height="15"
                                  Data="{StaticResource arrow_rotate_counterclockwise_regular}"/>
					</MenuItem.Icon>
				</MenuItem>

			</MenuFlyout>
		</Setter>

		<!-- Page -->
		<Setter Property="Template">
			<ControlTemplate>

				<ContentPresenter Name="PART_ContentPresenter">
					<ContentPresenter.Content>

						<LayoutTransformControl>
							<LayoutTransformControl.LayoutTransform>
								<RotateTransform Angle="{Binding Rotation}" />
							</LayoutTransformControl.LayoutTransform>

							<Grid Background="White"
								  Width="{Binding Size.Width}"
								  Height="{Binding Size.Height}">

								<Viewbox IsVisible="{Binding IsPageRendering}"
										 IsEnabled="{Binding IsPageRendering}"
										 HorizontalAlignment="Left"
										 VerticalAlignment="Top">
									<Viewbox.Width>
										<!-- No Height binding: Viewbox stretches uniformly, so Height follows Width-->
                                        <MultiBinding Converter="{StaticResource ProgressRingSizeConverter}">
											<Binding Path="VisibleArea"/>
											<Binding Path="Size"/>
										</MultiBinding>
									</Viewbox.Width>
									<Viewbox.Margin>
										<MultiBinding Converter="{StaticResource ProgressRingMarginConverter}">
											<Binding Path="VisibleArea"/>
											<Binding Path="Size"/>
										</MultiBinding>
									</Viewbox.Margin>
									<progRing:ProgressRing Width="50"
														   Height="50"
														   IsActive="{Binding IsPageRendering}"
														   Foreground="{DynamicResource SystemAccentColor}"/>
								</Viewbox>

								<rendering:TiledPdfPageControl TileRenderService="{Binding TileRenderService}"
                                                               Picture="{Binding PdfPicture}"
                                                               PpiScale="{Binding PpiScale}"
                                                               VisibleArea="{Binding VisibleArea}"
                                                               IsPageVisible="{Binding IsPageVisible}"
                                                               PageNumber="{Binding PageNumber}"
                                                               PageDisplaySize="{Binding Size}"
                                                               ZoomLevel="{Binding $parent[controls:PageItemsControl].ZoomLevel}"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Stretch"/>

								<controls:PageInteractiveLayerControl Name="PART_PageInteractiveLayerControl"
																	  Focusable="False"
                                                                      VisibleArea="{Binding VisibleArea}"
                                                                      PdfTextLayer="{Binding PdfTextLayer}"
                                                                      PageNumber="{Binding PageNumber}"
																	  SelectedWords="{Binding SelectedWords}"
																	  SearchResults="{Binding SearchResults}"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Stretch">

									<FlyoutBase.AttachedFlyout>
										<Flyout ShowMode="Standard"
												Placement="Pointer"
												HorizontalOffset="15"
												OverlayInputPassThroughElement="{Binding $parent}"/>
									</FlyoutBase.AttachedFlyout>

								</controls:PageInteractiveLayerControl>

							</Grid>
						</LayoutTransformControl>

					</ContentPresenter.Content>
				</ContentPresenter>

			</ControlTemplate>
		</Setter>

	</ControlTheme>

</ResourceDictionary>
