<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Change delays for all ScrollViewers -->
    <Style Selector="ScrollViewer /template/ ScrollBar#PART_VerticalScrollBar">
        <Setter Property="ShowDelay" Value="0:0:0.1" />
        <Setter Property="HideDelay" Value="0:0:0.5" />
    </Style>

    <Style Selector="ScrollViewer /template/ ScrollBar#PART_HorizontalScrollBar">
        <Setter Property="ShowDelay" Value="0:0:0.1" />
        <Setter Property="HideDelay" Value="0:0:0.5" />
    </Style>
    <!-- End change delays for all ScrollViewers -->

    <!-- Popups inherit UseLayoutRounding from the control they open on, and pages turn it off.
         Unrounded, Windows truncates the popup to whole pixels: menus show scroll arrows and tooltips lose
         their last word to a wrapped line that does not fit. -->
    <Style Selector="FlyoutPresenter, MenuFlyoutPresenter, ToolTip">
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- Hide app title in main window -->
    <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- End hide app title in main window -->

    <!-- Align the drawn caption buttons with the tab-strip title bar.
         On Linux (X11/XWayland, Wayland) Avalonia renders client-side window decorations
         with WindowDrawnDecorations. That template insets the caption-button overlay by the
         shadow + border thickness (~9 px at the top). But Caly extends its content to the very
         top of the client area - OffScreenMargin is 0 on X11, so our tab strip starts at y=0 -
         which leaves the min/max/close buttons ~9 px lower than the tab strip's "+" button:
         they look split by the title bar. Windows uses native caption buttons and is unaffected.
         Zero the overlay inset so the buttons sit in the title strip, flush to the top-right. -->
    <Style Selector="WindowDrawnDecorations:has-shadow /template/ Panel#PART_OverlayWrapper">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="WindowDrawnDecorations:has-border /template/ StackPanel#PART_OverlayPanel">
        <Setter Property="Margin" Value="0" />
    </Style>
    <!-- End align drawn caption buttons -->
</Styles>