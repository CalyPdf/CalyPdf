<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabalonia="clr-namespace:Tabalonia.Themes.Custom;assembly=Tabalonia"
             x:Class="Caly.Core.App"
             RequestedThemeVariant="Dark">

	<Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Caly.Core/CalyTheme.axaml"/>

				<ResourceInclude Source="avares://Caly.Core/Controls/DocumentControl.axaml"/>
                <ResourceInclude Source="avares://Caly.Core/Controls/DocumentPropertiesControl.axaml"/>

                <ResourceInclude Source="avares://Caly.Core/Controls/ThumbnailControl.axaml"/>

                <ResourceInclude Source="avares://Caly.Core/Controls/PageItemsControl.axaml"/>
				<ResourceInclude Source="avares://Caly.Core/Controls/PageItem.axaml"/>

                <ResourceInclude Source="avares://Caly.Core/Controls/FullSearchPanelControl.axaml"/>
                <ResourceInclude Source="avares://Caly.Core/Controls/VerticalSeparator.axaml"/>
                <ResourceInclude Source="avares://Caly.Core/Controls/Settings/SettingsControl.axaml"/>
                <ResourceInclude Source="avares://Caly.Core/Controls/Settings/LicenseControl.axaml"/>
			</ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme DensityStyle="Compact">
			<FluentTheme.Palettes>
                <!-- Generated by tools/Palette/GeneratePalette.cs from tools/Palette/palette.json. Edit the picks there, not these lines. -->
                <ColorPaletteResources x:Key="Light" Accent="#ff636b8f" AltHigh="#ffffffff" AltLow="#33ffffff" AltMedium="#99ffffff" AltMediumHigh="#ccffffff" AltMediumLow="#66ffffff" BaseHigh="#ff120821" BaseLow="#ff95909d" BaseMedium="#ff4a4256" BaseMediumHigh="#ff3a3247" BaseMediumLow="#ff696274" ChromeAltLow="#ff3a3247" ChromeBlackHigh="#ff000000" ChromeBlackLow="#33000000" ChromeBlackMedium="#cc000000" ChromeBlackMediumLow="#66000000" ChromeDisabledHigh="#ff95909d" ChromeDisabledLow="#ff696274" ChromeGray="#ffe0dee5" ChromeHigh="#ff95909d" ChromeLow="#ffd4d1d9" ChromeMedium="#ffdbd7e1" ChromeMediumLow="#ffe8e5ec" ChromeWhite="#ffffffff" ErrorText="#ffc50500" ListLow="#ffdbd7e1" ListMedium="#ff95909d" RegionColor="#ffeceaf0" />
                <ColorPaletteResources x:Key="Dark" Accent="#ff565c77" AltHigh="#ff000000" AltLow="#33000000" AltMedium="#99000000" AltMediumHigh="#cc000000" AltMediumLow="#66000000" BaseHigh="#ffffffff" BaseLow="#ff666666" BaseMedium="#ffb3b3b3" BaseMediumHigh="#ffc6c6c6" BaseMediumLow="#ff8c8c8c" ChromeAltLow="#ffc6c6c6" ChromeBlackHigh="#ff000000" ChromeBlackLow="#33000000" ChromeBlackMedium="#cc000000" ChromeBlackMediumLow="#66000000" ChromeDisabledHigh="#ff666666" ChromeDisabledLow="#ff8c8c8c" ChromeGray="#ff2a2a2a" ChromeHigh="#ff666666" ChromeLow="#ff212121" ChromeMedium="#ff6a6a6a" ChromeMediumLow="#ff585858" ChromeWhite="#ffffffff" ErrorText="#fffff000" ListLow="#ff6a6a6a" ListMedium="#ff666666" RegionColor="#ff333333" />
			</FluentTheme.Palettes>
		</FluentTheme>
		<tabalonia:CustomTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Fluent.axaml"/>

		<StyleInclude Source="avares://Caly.Core/Assets/Icons.axaml"/>
        <StyleInclude Source="avares://AvaloniaProgressRing/Styles/ProgressRing.xaml"/>
        <StyleInclude Source="avares://Caly.Core/CalyStyles.axaml"/>

	</Application.Styles>
</Application>
