<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabalonia="clr-namespace:Tabalonia.Themes.Custom;assembly=Tabalonia"
             x:Class="Caly.Core.App"
             RequestedThemeVariant="Dark">

	<Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Caly.Core/CalyTheme.axaml"/>

				<ResourceInclude Source="avares://Caly.Core/Controls/DocumentControl.axaml"/>
                <ResourceInclude Source="avares://Caly.Core/Controls/DocumentPropertiesControl.axaml"/>

                <ResourceInclude Source="avares://Caly.Core/Controls/ThumbnailControl.axaml"/>

                <ResourceInclude Source="avares://Caly.Core/Controls/PageItemsControl.axaml"/>
				<ResourceInclude Source="avares://Caly.Core/Controls/PageItem.axaml"/>

                <ResourceInclude Source="avares://Caly.Core/Controls/FullSearchPanelControl.axaml"/>
                <ResourceInclude Source="avares://Caly.Core/Controls/VerticalSeparator.axaml"/>
                <ResourceInclude Source="avares://Caly.Core/Controls/Settings/SettingsControl.axaml"/>
                <ResourceInclude Source="avares://Caly.Core/Controls/Settings/LicenseControl.axaml"/>
			</ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme DensityStyle="Compact">
			<FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#ff636B8F" AltHigh="White" AltLow="White" AltMedium="White" AltMediumHigh="White" AltMediumLow="White" BaseHigh="#ff120821" BaseLow="#ff9990a6" BaseMedium="#ff5d5470" BaseMediumHigh="#ff3a3049" BaseMediumLow="#ff4a4059" ChromeAltLow="#ff3a3049" ChromeBlackHigh="Black" ChromeBlackLow="#ff9990a6" ChromeBlackMedium="#ff3a3049" ChromeBlackMediumLow="#ff5d5470" ChromeDisabledHigh="#ff9990a6" ChromeDisabledLow="#ff5d5470" ChromeGray="#ff4a4059" ChromeHigh="#ff9990a6" ChromeLow="#ffe8e5ec" ChromeMedium="#ffdbd7e1" ChromeMediumLow="#ffe8e5ec" ChromeWhite="White" ListLow="#ffdbd7e1" ListMedium="#ff9990a6" RegionColor="#ffeceaf0" />
                <ColorPaletteResources x:Key="Dark" Accent="#ff565c77" AltHigh="Black" AltLow="Black" AltMedium="Black" AltMediumHigh="Black" AltMediumLow="Black" BaseHigh="White" BaseLow="#ff666666" BaseMedium="#ffb3b3b3" BaseMediumHigh="#ffc6c6c6" BaseMediumLow="#ff8c8c8c" ChromeAltLow="#ffc6c6c6" ChromeBlackHigh="Black" ChromeBlackLow="#ffc6c6c6" ChromeBlackMedium="Black" ChromeBlackMediumLow="Black" ChromeDisabledHigh="#ff666666" ChromeDisabledLow="#ffb3b3b3" ChromeGray="#ffa0a0a0" ChromeHigh="#ffa0a0a0" ChromeLow="#ff2d2d2d" ChromeMedium="#ff3b3b3b" ChromeMediumLow="#ff585858" ChromeWhite="White" ListLow="#ff3b3b3b" ListMedium="#ff666666" RegionColor="#ff333333" />
			</FluentTheme.Palettes>
		</FluentTheme>
		<tabalonia:CustomTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Fluent.axaml"/>

		<StyleInclude Source="avares://Caly.Core/Assets/Icons.axaml"/>
        <StyleInclude Source="avares://AvaloniaProgressRing/Styles/ProgressRing.xaml"/>
        <StyleInclude Source="avares://Caly.Core/CalyStyles.axaml"/>

	</Application.Styles>
</Application>
