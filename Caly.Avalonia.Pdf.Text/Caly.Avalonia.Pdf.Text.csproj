<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<SignAssembly>True</SignAssembly>
		<AssemblyOriginatorKeyFile>..\Caly.snk</AssemblyOriginatorKeyFile>

		<IsPackable>true</IsPackable>
		<PackageId>Caly.Avalonia.Pdf.Text</PackageId>
		<Version>0.1.0</Version>
		<Authors>BobLd</Authors>
		<Description>Avalonia PDF text interaction layer: selection/search highlight overlay, annotation flyout, and a cross-page text-selection model.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>avalonia;pdf;text;selection;annotation</PackageTags>
		<RepositoryUrl>https://github.com/CalyPdf/Caly</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.5" />
		<PackageReference Include="PdfPig" Version="0.1.16-alpha-20260629-34229" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Caly.Pdf.Models\Caly.Pdf.Models.csproj" />
	</ItemGroup>
</Project>
